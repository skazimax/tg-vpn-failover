[Unit]
Description=Stable SOCKS egress for MTProto proxy and Telegram control bot
Wants=network-online.target egg-cam-adguard.service adguardvpn.service mtproxy-vless.service
After=network-online.target egg-cam-adguard.service adguardvpn.service mtproxy-vless.service

[Service]
User=mtproxy-vless
Group=mtproxy-vless
ExecStart=/usr/bin/sing-box run -c /etc/sing-box/mtproxy-egress.json
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
