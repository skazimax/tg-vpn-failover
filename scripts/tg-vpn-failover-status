#!/usr/bin/env bash
set -euo pipefail

route=$(cat /run/mtproxy-failover/state 2>/dev/null || printf 'unknown')
shared=$(systemctl is-active mtproxy-egress.service 2>/dev/null || true)
adguard=$(systemctl is-active egg-cam-adguard.service 2>/dev/null || true)
vless=$(systemctl is-active mtproxy-vless.service 2>/dev/null || true)

case "$route" in
  adguard)
    route_label='AdGuard'
    upstream=$adguard
    ;;
  vless)
    route_label='SKIPP'
    upstream=$vless
    ;;
  *)
    route_label='не определён'
    upstream=inactive
    ;;
esac

if [[ $shared == active && $upstream == active ]]; then
  printf '✅ VPN: %s\n' "$route_label"
else
  printf '❌ VPN: %s\n' "$route_label"
fi

if [[ ${1:-} == --verbose ]]; then
  mtg=$(systemctl is-active mtg.service 2>/dev/null || true)
  failover=$(systemctl is-active mtproxy-failover.timer 2>/dev/null || true)
  if [[ $mtg == active && $shared == active ]] && \
      ss -lnt | grep -qE '(^|[[:space:]])[^[:space:]]*:443[[:space:]]'; then
    printf '✅ MTProto\n'
  else
    printf '❌ MTProto\n'
  fi
  if [[ $failover == active ]]; then
    printf '✅ Failover\n'
  else
    printf '❌ Failover\n'
  fi
fi
