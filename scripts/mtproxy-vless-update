#!/usr/bin/env bash
set -euo pipefail

umask 077
subscription_file=/etc/mtproxy-failover/subscriptions
config_file=/etc/sing-box/mtproxy-backup.json
source_url=$(sed -n '/[^[:space:]]/{p;q;}' "$subscription_file")
raw_file=$(mktemp)
config_tmp=$(mktemp)
trap 'rm -f "$raw_file" "$config_tmp"' EXIT

curl -4 -fsSL --connect-timeout 10 --max-time 45 \
  -A 'v2rayN/7.0' "$source_url" -o "$raw_file"

python3 - "$raw_file" "$config_tmp" <<'PY'
import base64
import json
import sys
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlsplit

encoded = b"".join(Path(sys.argv[1]).read_bytes().split())
encoded += b"=" * (-len(encoded) % 4)
decoded = base64.b64decode(encoded).decode("utf-8")
records = [line.strip() for line in decoded.splitlines()
           if line.strip().startswith("vless://")]

def display_name(record):
    return unquote(urlsplit(record).fragment).casefold()

# The provider publishes several automatic endpoints. Test every Auto+ node
# and fall back to the Auto group only when Auto+ is absent.
selected_records = [item for item in records if "авто+" in display_name(item)]
if not selected_records:
    selected_records = [item for item in records if "авто" in display_name(item)]
if not selected_records:
    raise SystemExit("the subscription contains no Auto+/Auto VLESS record")

def make_outbound(record, index):
    uri = urlsplit(record)
    query = {key: values[0] for key, values in parse_qs(uri.query).items()}
    required = ("security", "sni", "fp", "pbk", "sid", "type")
    missing = [key for key in required if not query.get(key)]
    if uri.scheme != "vless" or not uri.hostname or not uri.port or not uri.username:
        raise SystemExit("an Auto+/Auto VLESS record is incomplete")
    if missing:
        raise SystemExit("an Auto+/Auto VLESS record lacks required parameters")
    if query["security"] != "reality":
        raise SystemExit("only Reality VLESS records are supported")

    outbound = {
        "type": "vless",
        "tag": f"vless-{index}",
        "server": uri.hostname,
        "server_port": uri.port,
        "uuid": unquote(uri.username),
        "tls": {
            "enabled": True,
            "server_name": query["sni"],
            "utls": {"enabled": True, "fingerprint": query["fp"]},
            "reality": {
                "enabled": True,
                "public_key": query["pbk"],
                "short_id": query["sid"],
            },
        },
    }
    if query.get("flow"):
        outbound["flow"] = query["flow"]
    transport_type = query["type"]
    if transport_type == "grpc":
        outbound["transport"] = {
            "type": "grpc",
            "service_name": query.get("serviceName", ""),
        }
    elif transport_type not in ("tcp", "raw"):
        raise SystemExit("unsupported VLESS transport")
    return outbound

vless_outbounds = [make_outbound(record, index)
                   for index, record in enumerate(selected_records, start=1)]
urltest = {
    "type": "urltest",
    "tag": "vless-auto",
    "outbounds": [item["tag"] for item in vless_outbounds],
    "url": "https://core.telegram.org/getProxyConfig",
    "interval": "1m",
    "tolerance": 150,
    "idle_timeout": "10m",
    "interrupt_exist_connections": True,
}

config = {
    "log": {"level": "info", "timestamp": True},
    "inbounds": [{
        "type": "socks",
        "tag": "socks-in",
        "listen": "127.0.0.1",
        "listen_port": 1081,
    }],
    "outbounds": [urltest, *vless_outbounds],
}
Path(sys.argv[2]).write_text(json.dumps(config, indent=2) + "\n")
PY

/usr/bin/sing-box check -c "$config_tmp"
if ! cmp -s "$config_tmp" "$config_file"; then
  install -o root -g mtproxy-vless -m 0640 "$config_tmp" "$config_file"
  if systemctl is-active --quiet mtproxy-vless.service; then
    systemctl restart mtproxy-vless.service
  fi
  logger -t mtproxy-vless-update 'backup VLESS configuration updated'
fi
